{
  "name": "thesoundstable.com-react",
  "homepage": "https://thesoundstable.com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "classnames": "^2.3.2",
    "howler": "^2.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.4.2",
    "web-vitals": "^2.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --watchAll=false --runInBand",
    "validate:data": "CI=true react-scripts test --watchAll=false --runInBand src/data/boards.test.ts",
    "eject": "react-scripts eject",
    "sitemap": "node src/sitemap-generator.js",
    "predeploy": "corepack yarn build && echo 'thesoundstable.com' > ./build/CNAME && corepack yarn sitemap",
    "deploy": "corepack yarn predeploy && gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/howler": "^2.2.7",
    "@types/react-router-dom": "^5.3.3",
    "gh-pages": "^4.0.0",
    "typescript-plugin-css-modules": "^4.1.1",
    "typings-for-css-modules-loader": "^1.7.0"
  }
}
